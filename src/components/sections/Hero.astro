---
// Hero con la estructura de Moppers v2: foto + overlay, ondas SVG y booking card montada sobre la onda.
// Ver docs/DESIGN_SYSTEM.md §3.
import { Picture } from 'astro:assets';
import heroImg from '../../assets/images/hero.jpg';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import Waves from '../ui/Waves.astro';
import BookingCard from './BookingCard.astro';
import { hero } from '../../data/content';
import { anchor, QUOTE_ANCHOR } from '../../data/site';
---
<section class="on-dark relative isolate scroll-mt-(--header-h) text-white" id="home" aria-labelledby="hero-title">
  <div class="absolute inset-0 -z-10 overflow-hidden bg-primary" aria-hidden="true">
    <Picture
      src={heroImg}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1600, 1920]}
      sizes="100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
      quality={50}
      class="size-full object-cover object-[70%_40%]"
      pictureAttributes={{ class: 'block size-full' }}
    />
    <div class="absolute inset-0 bg-(image:--hero-overlay-mobile) lg:bg-(image:--hero-overlay)"></div>
    <Waves />
  </div>

  <div class="container-site grid gap-10 lg:min-h-[640px] lg:grid-cols-[1fr_var(--booking-w)] lg:items-end lg:gap-12">
    <div class="grid max-w-[640px] justify-items-start pt-16 lg:self-center lg:pt-24 lg:pb-34">
      <Eyebrow dark>{hero.eyebrow}</Eyebrow>
      <h1 id="hero-title" class="mt-5 mb-6 text-hero font-light text-white [&_strong]:font-extrabold">
        <!-- Una línea por frase (ref. 01-hero.jpg); pesos 300/800 estilo Moppers -->
        {hero.title.map((part, i) => (i % 2 ? <strong class="block">{part}</strong> : <span class="block">{part}</span>))}
      </h1>
      {hero.lead.map((p, i) => <p class:list={['max-w-[48ch] text-lead text-white/85', i === 0 ? 'mb-3' : 'mb-8']}>{p}</p>)}
      <div class="flex w-full flex-wrap gap-3 max-sm:[&>*]:basis-full">
        <Button href={anchor(QUOTE_ANCHOR, Astro.url.pathname)} icon="arrow-up-right">{hero.ctaPrimary}</Button>
        <Button variant="outline" href={anchor('#services', Astro.url.pathname)}>{hero.ctaSecondary}</Button>
      </div>
    </div>
    <BookingCard class="relative z-2 -mb-8 lg:-mb-[200px]" />
  </div>
</section>
