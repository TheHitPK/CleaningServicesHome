---
// Footer — ref. docs/referencias/contenido-aprobado/11-cta-y-footer.jpg
import Logo from '../ui/Logo.astro';
import Icon from '../icons/Icon.astro';
import { site, services, tel, anchor, QUOTE_ANCHOR } from '../../data/site';
import { footer, hero } from '../../data/content';

const path = Astro.url.pathname;
const link = 'inline-flex min-h-10 lg:min-h-8 items-center gap-2 transition-colors duration-150 hover:text-accent';
const title = 'mb-4 text-h4 text-white';
const quickLinks = [
  { label: 'Home', href: anchor('#home', path) },
  { label: 'About Us', href: anchor('#about', path) },
  { label: 'Our Work', href: anchor('#our-work', path) },
  { label: 'Contact', href: anchor('#contact', path) },
  { label: hero.ctaPrimary.replace(/\b\w/g, (c) => c.toUpperCase()), href: anchor(QUOTE_ANCHOR, path) },
];
---
<footer class="on-dark bg-primary-900 pt-20 pb-[calc(2rem+56px)] text-sm text-white/72 lg:pb-8">
  <div class="container-site">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1.1fr_1.4fr] lg:gap-12">
      <div class="grid content-start justify-items-start gap-3">
        <Logo variant="light" href={anchor('#home', path)} />
        <p class="my-2 max-w-[34ch]">{footer.about}</p>
        <a class={link} href={tel}><Icon name="phone" size={16} class="text-accent" /> {site.phone.display}</a>
        <a class={link} href={`mailto:${site.email}`}><Icon name="mail" size={16} class="text-accent" /> {site.email}</a>
      </div>
      <nav aria-labelledby="ft-links">
        <h2 class={title} id="ft-links">{footer.quickLinksTitle}</h2>
        <ul class="grid gap-1">{quickLinks.map((l) => <li><a class={link} href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <nav aria-labelledby="ft-services">
        <h2 class={title} id="ft-services">{footer.servicesTitle}</h2>
        <ul class="grid gap-1">{services.map((s) => <li><a class={link} href={anchor('#services', path)}>{s.short}</a></li>)}</ul>
      </nav>
      <div>
        <h2 class={title}>{footer.areasTitle}</h2>
        <p class="leading-relaxed">{footer.areasText}</p>
      </div>
    </div>

    <div class="mt-16 flex flex-wrap justify-between gap-x-8 gap-y-3 border-t border-white/12 pt-6 text-[.8125rem]">
      <span>© {new Date().getFullYear()} {site.legalName}. All Rights Reserved.</span>
      <span>{footer.bottomNote}</span>
    </div>
  </div>
</footer>
