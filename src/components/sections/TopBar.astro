---
import Icon from '../icons/Icon.astro';
import { site, tel } from '../../data/site';
const link = 'inline-flex min-h-10 items-center gap-2 transition-colors hover:text-accent';
---
<div class="bg-primary-900 text-[.8125rem] text-white/82">
  <div class="container-site flex min-h-10 items-center justify-center gap-4 md:justify-between">
    <div class="flex gap-6">
      <a class={link} href={tel}><Icon name="phone" size={14} class="text-accent" /> Call / Text: {site.phone.display}</a>
      <a class:list={[link, 'max-md:hidden']} href={`mailto:${site.email}`}><Icon name="mail" size={14} class="text-accent" /> {site.email}</a>
    </div>
    <span class="inline-flex items-center gap-2 max-md:hidden">
      <Icon name="map-pin" size={14} class="text-accent" /> Professional Cleaning in {site.region}
    </span>
  </div>
</div>
