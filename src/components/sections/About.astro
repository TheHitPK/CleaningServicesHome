---
// Comparte el grid del hero: la columna derecha queda libre para la booking card que baja desde el hero.
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from '../icons/Icon.astro';
import { about } from '../../data/content';
---
<section class="section pt-[calc(var(--section-y)+2rem)] lg:pt-(--section-y)" id="about" aria-labelledby="about-title">
  <div class="container-site lg:grid lg:grid-cols-[1fr_var(--booking-w)] lg:gap-12">
    <div class="grid max-w-[640px] justify-items-start gap-5">
      <SectionHeading eyebrow={about.eyebrow} title={about.title} id="about-title" wide class="mb-2!" />
      {about.body.map((p) => <p class="text-lead">{p}</p>)}
      <Button variant="link" href="#services" icon="arrow">{about.link}</Button>
    </div>
  </div>
  <div class="container-site">
    <ul class="mt-16 grid gap-6 md:grid-cols-3 lg:mt-20">
      {about.highlights.map((h) => (
        <li class="flex items-start gap-4 md:[&+&]:border-l md:[&+&]:border-line md:[&+&]:pl-6">
          <span class="grid size-14 shrink-0 place-items-center rounded-full bg-accent-100 text-primary">
            <Icon name={h.icon} size={26} />
          </span>
          <div>
            <h3 class="mb-1 text-h4">{h.title}</h3>
            <p class="text-sm leading-relaxed text-muted">{h.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
