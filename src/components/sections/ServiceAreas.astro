---
// Banda navy de ciudades (chips).
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../icons/Icon.astro';
import { serviceAreas, sms } from '../../data/site';
import { areas } from '../../data/content';
---
<section class="on-dark section bg-band text-white" id="service-areas" aria-labelledby="areas-title">
  <div class="container-site">
    <SectionHeading eyebrow={areas.eyebrow} title={areas.title} lead={areas.lead} layout="centered" dark id="areas-title" />
    <ul class="mx-auto flex max-w-[960px] flex-wrap justify-center gap-3">
      {serviceAreas.map((city) => (
        <li>
          <!-- Chip accionable: pregunta por servicio en esa ciudad (en escritorio precarga el formulario) -->
          <a
            class="inline-flex min-h-11 items-center gap-2 rounded-full border border-white/35 bg-white/6 px-5 text-[.9375rem] transition-colors hover:border-white/70 hover:bg-white/14"
            href={sms(`Hi Cleaning 4 You! Do you service ${city}? I'd like a quote.`)}
            data-prefill={`City: ${city}`}
          >
            <Icon name="map-pin" size={14} class="text-accent" />{city}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
