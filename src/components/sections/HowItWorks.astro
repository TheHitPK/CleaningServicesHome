---
// How it works — ref. docs/referencias/contenido-aprobado/04-how-it-works.jpg
// Banda navy con foto de fondo (lazy) + 3 pasos con ícono en círculo amarillo.
import { Image } from 'astro:assets';
import team from '../../assets/images/team.jpg';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../icons/Icon.astro';
import { process } from '../../data/content';
---
<section class="on-dark section relative isolate overflow-hidden text-center text-white" aria-labelledby="steps-title">
  <div class="absolute inset-0 -z-10 bg-primary" aria-hidden="true">
    <Image
      src={team} alt="" widths={[640, 1024, 1600]} sizes="100vw"
      loading="lazy" decoding="async" quality={50}
      class="size-full object-cover object-[center_40%]"
    />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgb(19_47_86/.94),rgb(23_58_90/.94))]"></div>
  </div>

  <div class="container-site">
    <SectionHeading eyebrow={process.eyebrow} title={process.title} layout="centered" dark fullWidth id="steps-title" />
    <ol class="grid gap-12 md:grid-cols-3 md:gap-10">
      {process.steps.map((step) => (
        <li class="grid justify-items-center gap-3">
          <span class="mb-2 grid size-14 place-items-center rounded-full bg-accent text-primary" aria-hidden="true">
            <Icon name={step.icon} size={24} />
          </span>
          <h3 class="text-white">{step.title}</h3>
          <p class="max-w-[34ch] text-[.9375rem] text-white/80">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
