---
// CTA final — ref. docs/referencias/contenido-aprobado/11-cta-y-footer.jpg
// Es la sección "Contact" del menú (#contact).
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import { sms, tel } from '../../data/site';
import { cta } from '../../data/content';
---
<section
  id="contact"
  class="on-dark scroll-mt-(--header-h) bg-[linear-gradient(100deg,var(--color-primary)_10%,var(--color-deep)_68%,#3973A2)] py-16 text-white"
  aria-labelledby="cta-title"
>
  <div class="container-site flex flex-col items-start justify-between gap-10 lg:flex-row lg:items-center">
    <div class="grid justify-items-start gap-4">
      <Eyebrow dark>{cta.eyebrow}</Eyebrow>
      <h2 id="cta-title" class="max-w-[18ch] text-white">{cta.title}</h2>
      <p class="text-white/85">{cta.lead}</p>
    </div>
    <div class="flex w-full flex-wrap gap-3 max-sm:[&>*]:basis-full lg:w-auto lg:flex-none">
      <Button variant="light" href={tel} iconStart="phone">Call now</Button>
      <Button variant="outline" href={sms()} iconStart="message">Send a text</Button>
    </div>
  </div>
</section>
