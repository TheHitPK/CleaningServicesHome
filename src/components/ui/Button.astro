---
import Icon from '../icons/Icon.astro';
import type { IconName } from '../icons/icons';

type Variant = 'primary' | 'secondary' | 'outline' | 'light' | 'link';
type Size = 'sm' | 'md' | 'lg';

interface Props {
  variant?: Variant;
  size?: Size;
  href?: string;
  type?: 'button' | 'submit';
  /** Ícono al final */
  icon?: IconName;
  /** Ícono al inicio */
  iconStart?: IconName;
  block?: boolean;
  class?: string;
  [attr: string]: unknown;
}

const {
  variant = 'primary', size = 'md', href, type = 'button',
  icon, iconStart, block = false, class: className, ...rest
} = Astro.props;

// DESIGN_SYSTEM §2.1
const base =
  'group/btn inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-sm border ' +
  'font-sans text-btn font-bold uppercase tracking-btn cursor-pointer ' +
  'transition-[transform,background-color,color,border-color,box-shadow] ' +
  'hover:-translate-y-0.5 hover:shadow-md active:translate-y-0 active:shadow-none ' +
  'disabled:pointer-events-none disabled:opacity-50';

const variants: Record<Variant, string> = {
  primary: 'bg-accent border-accent text-primary hover:bg-accent-600 hover:border-accent-600',
  secondary: 'bg-deep border-deep text-white hover:bg-primary hover:border-primary',
  outline: 'bg-transparent border-white/60 text-white hover:bg-white hover:border-white hover:text-primary',
  light: 'bg-white border-white text-primary',
  link: 'border-0 bg-transparent text-deep hover:translate-y-0 hover:shadow-none hover:underline underline-offset-4',
};

const sizes: Record<Size, string> = {
  sm: 'min-h-10 px-4',
  md: 'min-h-12 px-[26px]',
  lg: 'min-h-14 px-8',
};

const Tag = href ? 'a' : 'button';
---
<Tag
  class:list={[base, variants[variant], variant === 'link' ? 'min-h-11 px-0' : sizes[size], block && 'w-full', className]}
  href={href}
  type={href ? undefined : type}
  {...rest}
>
  {iconStart && <Icon name={iconStart} size={16} class="shrink-0" />}
  <span><slot /></span>
  {icon && <Icon name={icon} size={16} class="shrink-0 transition-transform group-hover/btn:translate-x-[3px]" />}
</Tag>
