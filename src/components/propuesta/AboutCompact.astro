---
// ⑧ About + Our Story + Mission/Vision/Philosophy en una sola sección (propuesta).
// Copy aprobado: historia (story), atributos (about.highlights) y bloques del folleto (mission).
import { Image } from 'astro:assets';
import team from '../../assets/images/team.jpg';
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../icons/Icon.astro';
import { about, story, mission } from '../../data/content';
---
<section class="section scroll-mt-(--header-h)" id="about" aria-labelledby="about-title">
  <div class="container-site">
    <div class="grid items-center gap-12 lg:grid-cols-[.9fr_1.1fr] lg:gap-16">
      <!-- PLACEHOLDER: reemplazar por una foto aprobada del dueño o del equipo -->
      <div class="relative aspect-4/3 overflow-hidden rounded-lg lg:aspect-4/5" data-placeholder>
        <Image
          src={team} alt="Illustrative professional cleaning team photo"
          widths={[480, 720, 960]} sizes="(min-width: 960px) 480px, 100vw"
          loading="lazy" decoding="async" quality={65} class="absolute inset-0 size-full object-cover"
        />
      </div>
      <div class="grid justify-items-start gap-5">
        <Eyebrow>{about.eyebrow}</Eyebrow>
        <h2 id="about-title" class="max-w-[18ch]">
          {story.title.map((line) => <span class="block">{line}</span>)}
        </h2>
        {story.body.map((p) => <p class="max-w-[62ch] text-lead">{p}</p>)}
        <ul class="mt-3 grid w-full gap-4 sm:grid-cols-3">
          {about.highlights.map((h) => (
            <li class="flex items-center gap-3">
              <span class="grid size-11 shrink-0 place-items-center rounded-full bg-accent-100 text-primary">
                <Icon name={h.icon} size={20} />
              </span>
              <span class="text-sm leading-snug font-semibold text-primary">{h.title}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bloques del folleto en formato compacto -->
    <ul class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-[1.7fr_1fr_1fr_1fr]">
      {mission.blocks.map((b) => (
        <li class="grid content-start gap-3 rounded-lg border border-line border-t-4 border-t-accent bg-white p-6 shadow-sm">
          <h3 class="text-h4">{b.title}</h3>
          <p class="text-sm leading-relaxed">{b.text}</p>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-center font-display text-h4 text-primary">{mission.tagline}</p>
  </div>
</section>
